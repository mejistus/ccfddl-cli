# Details view
# ---------------------------------------------------------------------------


def latest_edition(series: dict) -> Optional[dict]:
    editions = [edition for edition in series.get("confs") or [] if isinstance(edition, dict)]
    if not editions:
        return None

    def sort_key(edition: dict) -> tuple[int, str]:
        try:
            year = int(edition.get("year"))
        except (TypeError, ValueError):
            year = 0
        return year, str(edition.get("id") or "")

    return max(editions, key=sort_key)


def matched_series(catalog: list[dict], query: str, category: Optional[str]) -> list[dict]:
    needle = query.casefold()
    matches: list[dict] = []
    for series in catalog:
        if category is not None and str(series.get("sub") or "").casefold() != category.casefold():
            continue
        haystacks = (
            str(series.get("title") or ""),
            str(series.get("conference_key") or ""),
            str(series.get("description") or ""),
        )
        if any(needle in haystack.casefold() for haystack in haystacks):
            matches.append(series)
    matches.sort(
        key=lambda series: (
            str(series.get("title") or "").casefold(),
            str(series.get("conference_key") or ""),
        )
    )
    return matches


def details_series_json(series: dict, *, now_utc: datetime, display_tz: tzinfo) -> dict[str, Any]:
    conf = latest_edition(series)
    rank = series.get("rank") or {}
    timeline: list[dict[str, Any]] = []
    if conf is not None:
        zone = parse_source_timezone(conf.get("timezone"))
        for entry in conf.get("timeline") or []:
            if not isinstance(entry, dict):
                continue
            for field_name in ALL_KINDS:
                raw = entry.get(field_name)
                naive, status = parse_deadline(raw)
                if status == "absent":
                    continue
                row: dict[str, Any] = {
                    "kind": field_name,
                    "kind_label": KIND_LABELS.get(field_name, field_name),
                    "deadline_source": None if raw is None else str(raw).strip(),
                    "source_timezone": None if zone is None else zone.label,
                    "status": status,
                    "deadline_utc": None,
                    "deadline_local": None,
                    "passed": None,
                    "comment": str(entry.get("comment") or "").strip(),
                }
                if naive is not None and zone is not None:
                    utc = naive.replace(tzinfo=zone.tz).astimezone(timezone.utc)
                    row["deadline_utc"] = isoformat_seconds(utc)
                    row["deadline_local"] = isoformat_seconds(utc.astimezone(display_tz))
                    row["passed"] = utc <= now_utc
                timeline.append(row)
    return {
        "conference_key": str(series.get("conference_key") or ""),
        "conference": str(series.get("title") or ""),
        "description": str(series.get("description") or ""),
        "area": str(series.get("sub") or ""),
        "ranks": {
            "ccf": rank.get("ccf"),
            "core": rank.get("core"),
            "thcpl": rank.get("thcpl"),
        },
        "link": str((conf or {}).get("link") or ""),
        "event_date": str((conf or {}).get("date") or ""),
        "place": str((conf or {}).get("place") or ""),
        "edition_year": (conf or {}).get("year"),
        "source_timezone": None if conf is None else conf.get("timezone"),
        "timeline": timeline,
    }


def render_details(
    matches: list[dict],
    *,
    query: str,
    now_utc: datetime,
    display_tz: tzinfo,
    tz_label: str,
    colors: bool,
) -> list[str]:
    lines: list[str] = [
        paint(f"CCFDDL details for {query!r} — {len(matches)} matching series", BOLD, colors)
    ]
    for index, series in enumerate(matches):
        if index:
            lines.append("")
        conf = latest_edition(series)
        rank = series.get("rank") or {}
        lines.append(paint(str(series.get("title") or ""), BOLD_CYAN, colors))
        lines.append(f"  conference_key : {series.get('conference_key') or DASH}")
        lines.append(f"  description    : {series.get('description') or DASH}")
        lines.append(f"  area           : {series.get('sub') or DASH}")
        lines.append(
            "  ranks          : "
            f"CCF {rank.get('ccf') or DASH} · CORE {rank.get('core') or DASH} · "
            f"THCPL {rank.get('thcpl') or DASH}"
        )
        if conf is None:
            lines.append("  latest edition : (none in catalog)")
            continue
        lines.append(
            "  edition        : "
            f"{conf.get('year')} ({conf.get('id') or DASH}) "
            f"· source tz {conf.get('timezone') or DASH}"
        )
        lines.append(f"  event date     : {conf.get('date') or DASH}")
        lines.append(f"  place          : {conf.get('place') or DASH}")
        lines.append(f"  official link  : {conf.get('link') or DASH}")
        zone = parse_source_timezone(conf.get("timezone"))
        lines.append("")
        lines.append(
            paint(
                f"  latest-edition timeline (source → {tz_label}); PASSED = already past",
                DIM,
                colors,
            )
        )
        if zone is None:
            lines.append("    no recognized source timezone; cannot convert safely")
            continue
        timeline = [entry for entry in (conf.get("timeline") or []) if isinstance(entry, dict)]
        if not timeline:
            lines.append("    (no timeline entries in catalog)")
        for entry in timeline:
            comment = str(entry.get("comment") or "").strip()
            for field_name in ALL_KINDS:
                raw = entry.get(field_name)
                naive, status = parse_deadline(raw)
                if status == "absent":
                    continue
                label = f"{KIND_LABELS.get(field_name, field_name).upper():<9}"
                if status == "tbd":
                    rendered = f"{label} TBD (not announced)"
                elif naive is None:
                    rendered = f"{label} {raw!r} (unparsable, skipped)"
                else:
                    utc = naive.replace(tzinfo=zone.tz).astimezone(timezone.utc)
                    local = utc.astimezone(display_tz)
                    state = "  PASSED" if utc <= now_utc else ""
                    rendered = (
                        f"{label} {str(raw).strip()} {zone.label}"
                        f"  →  {local.strftime('%Y-%m-%d %H:%M:%S')} {format_offset_seconds(local)}"
                        f"{state}"
                    )
                if comment:
                    rendered += f"  [{comment}]"
                lines.append("    " + rendered)
    return lines


