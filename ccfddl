def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="ccfddl",
        description=(
            "Live CCF conference deadline viewer. Fetches the public CCFDDL catalog on every "
            "run and shows upcoming paper submission deadlines converted to your timezone. "
            "Nothing is hardcoded; TBD means the venue has not announced a date yet."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "examples:\n"
            "  %(prog)s                         all upcoming paper deadlines for the default area\n"
            "  %(prog)s --days 30                only deadlines in the next 30 days\n"
            "  %(prog)s --rank A --limit 10      first 10 CCF-A deadlines\n"
            "  %(prog)s --category all           every research area in the catalog\n"
            "  %(prog)s --tz UTC                 display deadline instants in UTC\n"
            "  %(prog)s --details <name>         full timeline for matching series\n"
            "  %(prog)s --include-tbd            also list series whose deadline is not announced\n"
            "  %(prog)s --json                   machine-readable output (audit fields included)\n"
            "\nData: " + DATA_URL + "\n"
            "Times are timezone-corrected (AoE=UTC-12; PT is DST-aware).\n"
            "Always verify a deadline on the official venue page before submitting."
        ),
    )
    parser.add_argument(
        "-d",
        "--days",
        type=nonnegative_int,
        default=0,
        metavar="N",
        help="only show deadlines within the next N days (default: 0 = all upcoming)",
    )
    parser.add_argument(
        "-r",
        "--rank",
        type=rank_list,
        default=None,
        metavar="LIST",
        help="comma-separated CCF rank filter, subset of A,B,C,N (default: all)",
    )
    parser.add_argument(
        "-c",
        "--category",
        default=None,
        metavar="CODE",
        help="research area code from the catalog, case-insensitive (default: AI; 'all' = every area)",
    )
    parser.add_argument(
        "--tz",
        type=validate_display_tz,
        default=None,
        metavar="TZ",
        help="display timezone: IANA name such as Asia/Shanghai, America/Los_Angeles, or UTC "
        "(default: system local timezone)",
    )
    parser.add_argument(
        "-i",
        "--details",
        default=None,
        metavar="QUERY",
        help="case-insensitive substring of series title / conference_key / description; "
        "show a per-series detail view instead of the table",
    )
    parser.add_argument(
        "-j",
        "--json",
        action="store_true",
        help="machine-readable JSON on stdout (no table, no ANSI colour)",
    )
    parser.add_argument(
        "--limit",
        type=nonnegative_int,
        default=0,
        metavar="N",
        help="maximum number of table rows (default: 0 = no limit)",
    )
    parser.add_argument(
        "--include-tbd",
        action="store_true",
        help="append a separate section listing series whose deadline is not announced yet",
    )
    parser.add_argument(
        "--all-kinds",
        action="store_true",
        help="also show abstract / rebuttal / decision timeline entries (default: paper only)",
    )
    parser.add_argument(
        "--data-file",
        default=None,
        metavar="PATH",
        help="read catalog JSON from a local file instead of the network ('-' = stdin)",
    )
    parser.add_argument(
        "--timeout",
        type=positive_float,
        default=DEFAULT_TIMEOUT,
        metavar="SECS",
        help=f"network timeout in seconds (default: {DEFAULT_TIMEOUT:g})",
    )
    parser.add_argument(
        "--no-color",
        action="store_true",
        help="disable ANSI colour (also honours NO_COLOR; auto-disabled when stdout is not a TTY)",
    )
    parser.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="also print the footer: data source, fetch time, counts and the accuracy caveat "
        "(quiet by default)",
    )
    parser.add_argument(
        "--version",
        action="version",
        version=f"%(prog)s {VERSION}",
        help="print version and exit",
    )
    return parser


def main(argv: Optional[list[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        exit_code = run(args)
        sys.stdout.flush()
        return exit_code
    except CliError as exc:
        print(f"ccfddl: error: {exc.message}", file=sys.stderr)
        return exc.code
    except BrokenPipeError:
        # Downstream closed the pipe (for example `| head`): exit quietly and
        # stop Python from flushing into the broken pipe during shutdown.
        try:
            devnull = os.open(os.devnull, os.O_WRONLY)
            os.dup2(devnull, sys.stdout.fileno())
        except OSError:
            pass
        return 0
    except KeyboardInterrupt:
        print("ccfddl: interrupted", file=sys.stderr)
        return 130


def run(args: argparse.Namespace) -> int:
    if args.tz is not None:
        display_tz_label, display_tz = args.tz, ZoneInfo(args.tz)
    else:
        display_tz_label, display_tz = detect_system_timezone()

    now_utc = datetime.now(timezone.utc).replace(microsecond=0)
    term_width = terminal_width()
    catalog, fetched_at, origin = read_catalog(args, now_utc)
    warnings = Warnings()

    # --details searches the whole catalog unless the user constrained the area.
    if args.details is not None:
        query = args.details.strip()
        if not query:
            raise UsageError("--details requires a non-empty query")
        details_category = resolve_category(catalog, args.category) if args.category is not None else None
        matches = matched_series(catalog, query, details_category)
        if args.json:
            payload = {
                "source": DATA_URL,
                "fetched_at": isoformat_seconds(fetched_at),
                "display_timezone": display_tz_label,
                "now_utc": isoformat_seconds(now_utc),
                "query": query,
                "matches": [
                    details_series_json(series, now_utc=now_utc, display_tz=display_tz)
                    for series in matches
                ],
            }
            print(json.dumps(payload, ensure_ascii=False, indent=2))
            return 0
        if not matches:
            print(f"ccfddl: no series matched {query!r}", file=sys.stderr)
            print(
                "hint: matching is a case-insensitive substring of title, conference_key or "
                "description; try a shorter query."
            )
            return 0
        detail_lines: list[str] = []
        for line in render_details(
            matches,
            query=query,
            now_utc=now_utc,
            display_tz=display_tz,
            tz_label=display_tz_label,
            colors=False,
        ):
            detail_lines.extend(wrap_display_line(line, term_width))
        print("\n".join(detail_lines))
        return 0

    category = resolve_category(catalog, args.category)
    events, tracked = build_events(
        catalog,
        category=category,
        ranks=args.rank,
        now_utc=now_utc,
        display_tz=display_tz,
        all_kinds=bool(args.all_kinds),
        warnings=warnings,
    )
    events = filter_events(events, days=args.days, now_utc=now_utc)
    tbd = build_tbd(
        catalog,
        category=category,
        ranks=args.rank,
        now_utc=now_utc,
        display_tz=display_tz,
    )
    matched = len(events)
    events, _hidden = apply_limit(events, args.limit)

    for line in warnings.lines():
        print(f"ccfddl: warning: {line}", file=sys.stderr)

    if args.json:
        payload = build_json_payload(
            args=args,
            fetched_at=fetched_at,
            display_tz=display_tz,
            tz_label=display_tz_label,
            category=category,
            tracked=tracked,
            events=events,
            tbd=tbd,
            now_utc=now_utc,
        )
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0

    colors = colors_enabled(args)
    title = title_line(category, args.rank, args.days)
    rendered_title = title_lines(title, term_width, colors)

    if not events:
        for line in rendered_title:
            print(line)
        print("")
        print(
            f"No upcoming {category_label(category)} "
            f"{'timeline' if args.all_kinds else 'paper'} deadlines match the current filters."
        )
        if args.verbose:
            for line in footer_lines(
                args=args,
                fetched_at=fetched_at,
                origin=origin,
                display_tz=display_tz,
                tz_label=display_tz_label,
                category=category,
                tracked=tracked,
                shown=0,
                matched=matched,
                tbd_count=len(tbd),
                all_kinds=bool(args.all_kinds),
                term_width=term_width,
            ):
                print(line)
        if args.include_tbd:
            for line in tbd_lines(tbd, term_width=term_width, colors=colors):
                print(line)
        return 0

    layout = compute_layout(
        events,
        term_width=term_width,
        all_kinds=bool(args.all_kinds),
        tz_label=display_tz_label,
    )

    use_rich = sys.stdout.isatty() and rich_available()
    for line in rendered_title:
        print(line)
    print("")
    if use_rich:
        try:
            lines = rich_table_lines(
                events,
                layout=layout,
                tz_label=display_tz_label,
                colors=colors,
                all_kinds=bool(args.all_kinds),
            )
        except Exception:
            lines = table_lines(
                events,
                layout=layout,
                tz_label=display_tz_label,
                colors=colors,
                all_kinds=bool(args.all_kinds),
            )
    else:
        lines = table_lines(
            events,
            layout=layout,
            tz_label=display_tz_label,
            colors=colors,
            all_kinds=bool(args.all_kinds),
        )
    for line in lines:
        print(line)

    if args.verbose:
        print("")
        for line in footer_lines(
            args=args,
            fetched_at=fetched_at,
            origin=origin,
            display_tz=display_tz,
            tz_label=display_tz_label,
            category=category,
            tracked=tracked,
            shown=len(events),
            matched=matched,
            tbd_count=len(tbd),
            all_kinds=bool(args.all_kinds),
            term_width=term_width,
        ):
            print(line)

    if args.include_tbd:
        for line in tbd_lines(tbd, term_width=term_width, colors=colors):
            print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main())
