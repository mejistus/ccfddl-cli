@dataclass
class Event:
    conference_key: str
    conference: str
    year: int
    ccf_rank: Optional[str]
    kind: str
    deadline_utc: datetime
    deadline_local: datetime
    deadline_source: str
    source_timezone: str
    abstract_utc: Optional[datetime]
    abstract_local: Optional[datetime]
    abstract_source: Optional[str]
    seconds_left: int
    comment: str
    event_date: str
    place: str
    link: str

    @property
    def rank_cell(self) -> str:
        if self.ccf_rank in ("A", "B", "C"):
            return self.ccf_rank
        return DASH

    @property
    def kind_label(self) -> str:
        return KIND_LABELS.get(self.kind, self.kind)


@dataclass
class TbdEntry:
    conference_key: str
    conference: str
    year: int
    ccf_rank: Optional[str]
    event_date: str
    place: str
    link: str

    @property
    def rank_cell(self) -> str:
        if self.ccf_rank in ("A", "B", "C"):
            return self.ccf_rank
        return DASH


def isoformat_seconds(moment: Optional[datetime]) -> Optional[str]:
    if moment is None:
        return None
    return moment.replace(microsecond=0).isoformat()


def build_events(
    catalog: list[dict],
    *,
    category: Optional[str],
    ranks: Optional[list[str]],
    now_utc: datetime,
    display_tz: tzinfo,
    all_kinds: bool,
    warnings: Warnings,
) -> tuple[list[Event], int]:
    """Build upcoming events and count the series under consideration."""
    events: list[Event] = []
    seen: set[tuple] = set()
    tracked = 0

    for series in catalog:
        sub = series.get("sub")
        if category is not None and str(sub or "").casefold() != category.casefold():
            continue
        ccf_rank = series_rank(series)
        if ranks is not None and ccf_rank not in ranks:
            continue
        tracked += 1

        conference_key = str(series.get("conference_key") or series.get("title") or "").strip()
        conference = str(series.get("title") or conference_key).strip()

        for edition in series.get("confs") or []:
            if not isinstance(edition, dict):
                continue
            try:
                edition_year = int(edition.get("year"))
            except (TypeError, ValueError):
                edition_year = 0
            zone = parse_source_timezone(edition.get("timezone"))
            timeline = edition.get("timeline") or []
            if zone is None:
                if any(
                    parse_deadline(entry.get(field_name))[1] == "ok"
                    for entry in timeline
                    if isinstance(entry, dict)
                    for field_name in ALL_KINDS
                ):
                    warnings.unknown_tz(edition.get("timezone"), conference)
                continue

            edition_id = edition.get("id") or f"{conference_key}-{edition_year}"
            event_date = str(edition.get("date") or "").strip()
            place = str(edition.get("place") or "").strip()
            link = str(edition.get("link") or "").strip()

            for entry in timeline:
                if not isinstance(entry, dict):
                    continue
                comment = str(entry.get("comment") or "").strip()
                abstract_naive, _ = parse_deadline(entry.get("abstract_deadline"))
                abstract_utc = (
                    abstract_naive.replace(tzinfo=zone.tz).astimezone(timezone.utc)
                    if abstract_naive is not None
                    else None
                )

                for field_name in (ALL_KINDS if all_kinds else (PAPER,)):
                    raw = entry.get(field_name)
                    naive, status = parse_deadline(raw)
                    if status == "malformed":
                        warnings.malformed(field_name, raw, conference, edition_year)
                        continue
                    if naive is None:  # TBD or absent: never invent a date
                        continue
                    utc = naive.replace(tzinfo=zone.tz).astimezone(timezone.utc)
                    if utc <= now_utc:
                        continue
                    dedupe_key = (
                        conference_key,
                        str(edition_id),
                        field_name,
                        utc.replace(microsecond=0).isoformat(),
                        comment,
                    )
                    if dedupe_key in seen:
                        continue
                    seen.add(dedupe_key)

                    if field_name == PAPER:
                        abs_utc, abs_source = abstract_utc, entry.get("abstract_deadline")
                    elif field_name == "abstract_deadline":
                        abs_utc, abs_source = utc, raw
                    else:
                        abs_utc, abs_source = None, None

                    seconds_left = int((utc - now_utc).total_seconds())
                    events.append(
                        Event(
                            conference_key=conference_key,
                            conference=conference,
                            year=edition_year,
                            ccf_rank=ccf_rank,
                            kind=field_name,
                            deadline_utc=utc,
                            deadline_local=utc.astimezone(display_tz),
                            deadline_source=str(raw).strip(),
                            source_timezone=zone.label,
                            abstract_utc=abs_utc,
                            abstract_local=abs_utc.astimezone(display_tz) if abs_utc else None,
                            abstract_source=str(abs_source).strip() if abs_source else None,
                            seconds_left=seconds_left,
                            comment=comment,
                            event_date=event_date,
                            place=place,
                            link=link,
                        )
                    )

    events.sort(
        key=lambda event: (
            event.deadline_utc,
            event.conference.casefold(),
            event.year,
            event.kind,
            event.comment.casefold(),
            event.conference_key,
        )
    )
    return events, tracked


def build_tbd(
    catalog: list[dict],
    *,
    category: Optional[str],
    ranks: Optional[list[str]],
    now_utc: datetime,
    display_tz: tzinfo,
) -> list[TbdEntry]:
    """Series with no announced (still TBD/absent) deadline in their latest edition."""
    current_year = now_utc.astimezone(display_tz).year
    entries: list[TbdEntry] = []

    for series in catalog:
        sub = series.get("sub")
        if category is not None and str(sub or "").casefold() != category.casefold():
            continue
        ccf_rank = series_rank(series)
        if ranks is not None and ccf_rank not in ranks:
            continue

        editions = [edition for edition in series.get("confs") or [] if isinstance(edition, dict)]
        if not editions:
            continue

        # (a) no upcoming dated paper deadline in any edition.
        has_upcoming = False
        for edition in editions:
            zone = parse_source_timezone(edition.get("timezone"))
            if zone is None:
                continue
            for entry in edition.get("timeline") or []:
                if not isinstance(entry, dict):
                    continue
                naive, status = parse_deadline(entry.get(PAPER))
                if status != "ok" or naive is None:
                    continue
                if naive.replace(tzinfo=zone.tz).astimezone(timezone.utc) > now_utc:
                    has_upcoming = True
                    break
            if has_upcoming:
                break
        if has_upcoming:
            continue

        years: list[int] = []
        for edition in editions:
            try:
                years.append(int(edition.get("year")))
            except (TypeError, ValueError):
                continue
        if not years:
            continue
        latest_year = max(years)
        # (c) latest edition year >= current display year.
        if latest_year < current_year:
            continue

        latest_editions = []
        for edition in editions:
            try:
                edition_year = int(edition.get("year"))
            except (TypeError, ValueError):
                continue
            if edition_year == latest_year:
                latest_editions.append(edition)

        # (b) every timeline entry's paper deadline in the latest edition is TBD/absent.
        announce_missing = True
        for edition in latest_editions:
            timeline = edition.get("timeline") or []
            for entry in timeline:
                if not isinstance(entry, dict):
                    continue
                _, status = parse_deadline(entry.get(PAPER))
                if status not in ("tbd", "absent"):
                    announce_missing = False
                    break
            if not announce_missing:
                break
        if not announce_missing:
            continue

        chosen = sorted(latest_editions, key=lambda edition: str(edition.get("id") or ""))[-1]
        entries.append(
            TbdEntry(
                conference_key=str(series.get("conference_key") or series.get("title") or "").strip(),
                conference=str(series.get("title") or "").strip(),
                year=latest_year,
                ccf_rank=ccf_rank,
                event_date=str(chosen.get("date") or "").strip(),
                place=str(chosen.get("place") or "").strip(),
                link=str(chosen.get("link") or "").strip(),
            )
        )

    entries.sort(key=lambda entry: (entry.conference.casefold(), entry.year, entry.conference_key))
    return entries


# ---------------------------------------------------------------------------
# Filtering
# ---------------------------------------------------------------------------


def filter_events(events: list[Event], *, days: int, now_utc: datetime) -> list[Event]:
    if days <= 0:
        return events
    cutoff = now_utc + timedelta(days=days)
    return [event for event in events if event.deadline_utc <= cutoff]


def apply_limit(events: list[Event], limit: int) -> tuple[list[Event], int]:
    if limit <= 0 or limit >= len(events):
        return events, 0
    return events[:limit], len(events) - limit


# ---------------------------------------------------------------------------
# Unicode-width-aware text helpers (stdlib only)
# ---------------------------------------------------------------------------


def char_width(char: str) -> int:
    if unicodedata.combining(char):
        return 0
    return 2 if unicodedata.east_asian_width(char) in ("W", "F") else 1


def text_width(text: str) -> int:
    return sum(char_width(char) for char in text)


def truncate(text: str, width: int) -> str:
    if width <= 0:
        return ""
    if text_width(text) <= width:
        return text
    if width == 1:
        return ELLIPSIS
    chunk: list[str] = []
    used = 0
    for char in text:
        size = char_width(char)
        if used + size > width - 1:
            break
        chunk.append(char)
        used += size
    return "".join(chunk) + ELLIPSIS


def pad(text: str, width: int, align: str = "left") -> str:
    visible = text_width(text)
    if visible > width:
        text = truncate(text, width)
        visible = text_width(text)
    filler = " " * (width - visible)
    return text + filler if align == "left" else filler + text


def paint(text: str, code: str, enabled: bool) -> str:
    if not enabled or not text:
        return text
    return f"\x1b[{code}m{text}\x1b[0m"


def render_cell(text: str, width: int, color: Optional[str] = None, colors: bool = False) -> str:
    """Pad a cell to width, colouring only its visible content (not the padding)."""
    visible = truncate(text, width)
    printed = paint(visible, color, colors) if color else visible
    return printed + " " * (width - text_width(visible))


def format_countdown(seconds: int) -> str:
    if seconds < 3600:
        return "<1h"
    if seconds < DAY:
        hours = seconds // 3600
        minutes = (seconds % 3600) // 60
        return f"{hours}h {minutes}m" if minutes else f"{hours}h"
    days = seconds // DAY
    hours = (seconds % DAY) // 3600
    return f"{days}d {hours}h" if hours else f"{days}d"


def countdown_color(seconds: int) -> str:
    if seconds <= 3 * DAY:
        return RED
    if seconds <= 14 * DAY:
        return YELLOW
    return GREEN


def format_local_datetime(moment: datetime) -> str:
    return f"{moment.strftime('%Y-%m-%d')} {WEEKDAYS[moment.weekday()]} {moment.strftime('%H:%M')}"


def format_abstract_datetime(moment: datetime) -> str:
    return moment.strftime("%Y-%m-%d %H:%M")


def abstract_cell(event: "Event", width: int) -> str:
    """Abstract deadline for the same timeline entry, compact at narrow widths."""
    if event.abstract_local is None:
        return DASH
    if width >= text_width("YYYY-MM-DD HH:MM"):
        return format_abstract_datetime(event.abstract_local)
    return event.abstract_local.strftime("%m-%d %H:%M")


def terminal_width() -> int:
    raw = os.environ.get("COLUMNS")
    if raw:
        try:
            columns = int(raw)
        except ValueError:
            columns = 0
        if columns > 0:
            return max(48, min(columns, 180))
    try:
        columns = shutil.get_terminal_size(fallback=(100, 24)).columns
    except OSError:
        columns = 100
    return max(48, min(columns, 180))


def colors_enabled(args: argparse.Namespace) -> bool:
    if args.no_color:
        return False
    if "NO_COLOR" in os.environ:
        return False
    if os.environ.get("TERM", "") == "dumb":
        return False
    return sys.stdout.isatty()


# ---------------------------------------------------------------------------
# Table layout & rendering
# ---------------------------------------------------------------------------


@dataclass
class Layout:
    term_width: int
    conf_width: int
    ccf_width: int
    kind_width: int
    deadline_width: int
    left_width: int
    abstract_width: int
    note_width: int
    gaps: int
    single_line_tz_header: bool

    @property
    def columns(self) -> int:
        return 6 + (1 if self.kind_width else 0)

    @property
    def total_width(self) -> int:
        return (
            self.conf_width
            + self.ccf_width
            + self.kind_width
            + self.deadline_width
            + self.left_width
            + self.abstract_width
            + self.note_width
            + self.gaps
        )


def compute_layout(
    events: list[Event],
    *,
    term_width: int,
    all_kinds: bool,
    tz_label: str,
) -> Layout:
    conf_needed = text_width("Conference")
    note_needed = text_width("Note")
    left_needed = text_width("Left")
    abstract_needed = text_width("Abstract")
    for event in events:
        conf_needed = max(conf_needed, text_width(f"{event.conference} {event.year}"))
        note_needed = max(note_needed, text_width(event.comment or DASH))
        left_needed = max(left_needed, text_width(format_countdown(event.seconds_left)))
        if event.abstract_local is not None:
            abstract_needed = max(abstract_needed, text_width(format_abstract_datetime(event.abstract_local)))

    ccf_width = 3
    kind_width = 8 if all_kinds else 0
    single_line_tz_header = term_width >= 104
    if single_line_tz_header:
        deadline_width = max(20, text_width(f"Deadline ({tz_label})"))
    else:
        deadline_width = max(20, text_width(f"({tz_label})"))
    left_width = max(6, left_needed)

    columns = 6 + (1 if all_kinds else 0)
    gaps = 2 * (columns - 1)
    fixed_base = ccf_width + kind_width + deadline_width + left_width + gaps

    # Pick the widest layout that fits: prefer the full abstract column, then a
    # compact "MM-DD HH:MM" form, and only then squeeze the note column. The
    # conference column is kept at >= 12 so venue names stay recognisable.
    abstract_options = [max(abstract_needed, 11)]
    if abstract_options[0] > 11:
        abstract_options.append(11)
    chosen: Optional[tuple[int, int, int]] = None
    for candidate_abstract in abstract_options:
        for candidate_note in (10, 8, 6, 4):
            if fixed_base + candidate_abstract + 12 + candidate_note <= term_width:
                chosen = (candidate_abstract, 12, candidate_note)
                break
        if chosen is not None:
            break
    if chosen is None:
        # Below the practical minimum width: best effort, never wrap a date token.
        candidate_abstract = abstract_options[-1]
        available = max(10, term_width - (fixed_base + candidate_abstract))
        chosen = (candidate_abstract, 8, max(2, min(4, available - 8)))
    abstract_width, conf_min, note_min = chosen

    fixed = fixed_base + abstract_width
    available = max(conf_min + note_min, term_width - fixed)
    conf_width = max(conf_min, min(conf_needed, available - note_min))
    note_width = max(note_min, available - conf_width)
    if conf_width + note_width < available:
        note_width = available - conf_width

    return Layout(
        term_width=term_width,
        conf_width=conf_width,
        ccf_width=ccf_width,
        kind_width=kind_width,
        deadline_width=deadline_width,
        left_width=left_width,
        abstract_width=abstract_width,
        note_width=note_width,
        gaps=gaps,
        single_line_tz_header=single_line_tz_header,
    )


def table_lines(
    events: list[Event],
    *,
    layout: Layout,
    tz_label: str,
    colors: bool,
    all_kinds: bool,
) -> list[str]:
    """Render the aligned table without third-party dependencies."""
    gap = " " * 2

    def header_row() -> str:
        cells = [pad("Conference", layout.conf_width), pad("CCF", layout.ccf_width)]
        if all_kinds:
            cells.append(pad("Kind", layout.kind_width))
        cells.append(
            pad(
                f"Deadline ({tz_label})" if layout.single_line_tz_header else "Deadline",
                layout.deadline_width,
            )
        )
        cells.extend(
            [
                pad("Left", layout.left_width),
                pad("Abstract", layout.abstract_width),
                pad("Note", layout.note_width),
            ]
        )
        return gap.join(cells)

    lines: list[str] = [header_row()]
    if not layout.single_line_tz_header:
        tz_header = f"({tz_label})"
        padded_tz = pad(tz_header, layout.deadline_width)
        cells = [pad("", layout.conf_width), pad("", layout.ccf_width)]
        if all_kinds:
            cells.append(pad("", layout.kind_width))
        cells.extend(
            [
                padded_tz,
                pad("", layout.left_width),
                pad("", layout.abstract_width),
                pad("", layout.note_width),
            ]
        )
        lines.append(gap.join(cells))

    if colors:
        lines = [paint(line, BOLD_CYAN, True) for line in lines]
    lines.append(HORIZONTAL * min(layout.total_width, layout.term_width))

    for event in events:
        cells = [
            render_cell(f"{event.conference} {event.year}", layout.conf_width, BOLD, colors),
            render_cell(event.rank_cell, layout.ccf_width, RANK_COLORS.get(event.ccf_rank or "", DIM), colors),
        ]
        if all_kinds:
            cells.append(render_cell(event.kind_label, layout.kind_width, DIM, colors))
        cells.extend(
            [
                render_cell(format_local_datetime(event.deadline_local), layout.deadline_width),
                render_cell(
                    format_countdown(event.seconds_left),
                    layout.left_width,
                    countdown_color(event.seconds_left),
                    colors,
                ),
                render_cell(
                    abstract_cell(event, layout.abstract_width),
                    layout.abstract_width,
                    DIM,
                    colors,
                ),
                render_cell(event.comment or DASH, layout.note_width, DIM, colors),
            ]
        )
        lines.append(gap.join(cells))

    return lines


def rich_available() -> bool:
    try:
        import rich.box  # noqa: F401
        import rich.console  # noqa: F401
        import rich.table  # noqa: F401
    except Exception:
        return False
    return True


def rich_table_lines(
    events: list[Event],
    *,
    layout: Layout,
    tz_label: str,
    colors: bool,
    all_kinds: bool,
) -> list[str]:
    """Render the table with optional `rich` polish (interactive terminals only)."""
    from rich import box
    from rich.console import Console
    from rich.table import Table

    console = Console(
        width=layout.term_width,
        no_color=not colors,
        force_terminal=colors,
        highlight=False,
        soft_wrap=False,
    )
    table = Table(
        box=box.SIMPLE_HEAD,
        show_edge=False,
        pad_edge=False,
        padding=(0, 1),
        expand=False,
        header_style="bold cyan",
    )
    table.add_column("Conference", width=layout.conf_width, no_wrap=True, overflow="ellipsis")
    table.add_column("CCF", width=layout.ccf_width, no_wrap=True)
    if all_kinds:
        table.add_column("Kind", width=layout.kind_width, no_wrap=True)
    if layout.single_line_tz_header:
        table.add_column(f"Deadline ({tz_label})", width=layout.deadline_width, no_wrap=True)
    else:
        table.add_column("Deadline\n(" + tz_label + ")", width=layout.deadline_width, no_wrap=True)
    table.add_column("Left", width=layout.left_width, no_wrap=True)
    table.add_column("Abstract", width=layout.abstract_width, no_wrap=True)
    table.add_column("Note", width=layout.note_width, no_wrap=True, overflow="ellipsis")

    for event in events:
        row: list[str] = [f"{event.conference} {event.year}", event.rank_cell]
        if all_kinds:
            row.append(event.kind_label)
        row.append(format_local_datetime(event.deadline_local))
        row.append(f"[{countdown_color(event.seconds_left)}]{format_countdown(event.seconds_left)}[/]")
        row.append(abstract_cell(event, layout.abstract_width))
        row.append(event.comment or DASH)
        table.add_row(*row)

    with console.capture() as capture:
        console.print(table)
    return capture.get().rstrip("\n").splitlines()


