def category_label(category: Optional[str]) -> str:
    return "all areas" if category is None else category


def title_line(category: Optional[str], ranks: Optional[list[str]], days: int) -> str:
    text = f"Upcoming {category_label(category)} Conference Deadlines — live CCFDDL data"
    extras: list[str] = []
    if ranks:
        extras.append("CCF " + "/".join(ranks) + " only")
    if days:
        extras.append(f"next {days} days")
    if extras:
        text += " (" + ", ".join(extras) + ")"
    return text


def wrap_display_line(text: str, width: int) -> list[str]:
    """Wrap one display line, hanging continuation lines under the content."""
    if text_width(text) <= width:
        return [text]
    if " : " in text:
        head, body = text.split(" : ", 1)
        prefix = head + " : "
        indent = text_width(prefix)
        chunks = textwrap.wrap(
            body, width=max(10, width - indent), break_long_words=True, break_on_hyphens=False
        ) or [""]
        return [prefix + chunks[0]] + [" " * indent + chunk for chunk in chunks[1:]]
    indent = len(text) - len(text.lstrip(" "))
    continuation = indent + 2
    chunks = textwrap.wrap(
        text.strip(),
        width=max(10, width - continuation),
        break_long_words=True,
        break_on_hyphens=False,
    ) or [""]
    return [" " * indent + chunks[0]] + [" " * continuation + chunk for chunk in chunks[1:]]


def title_lines(title: str, width: int, colors: bool) -> list[str]:
    chunks = textwrap.wrap(title, width=max(20, width), break_long_words=False) or [title]
    return [paint(chunk, BOLD, colors) for chunk in chunks]


def wrap_prefixed(text: str, width: int, indent: int) -> list[str]:
    """Word-wrap a prefixed line, hanging subsequent lines under the content."""
    if text_width(text) <= width:
        return [text]
    head = text[:indent]
    body = text[indent:]
    available = max(20, width - indent)
    chunks = textwrap.wrap(
        body, width=available, break_long_words=True, break_on_hyphens=False
    ) or [""]
    wrapped = [head + chunks[0]]
    wrapped.extend(" " * indent + chunk for chunk in chunks[1:])
    return wrapped



def footer_lines(
    *,
    args: argparse.Namespace,
    fetched_at: datetime,
    origin: str,
    display_tz: tzinfo,
    tz_label: str,
    category: Optional[str],
    tracked: int,
    shown: int,
    matched: int,
    tbd_count: int,
    all_kinds: bool,
    term_width: int,
) -> list[str]:
    local_fetched = fetched_at.astimezone(display_tz)
    utc_fetched = fetched_at.astimezone(timezone.utc)
    offset = format_offset_seconds(local_fetched)
    raw: list[str] = [HORIZONTAL * 64]
    raw.append(f"source   : {DATA_URL}")
    raw.append(
        f"fetched  : {local_fetched.strftime('%Y-%m-%d %H:%M:%S')} {offset}"
        f"  ({utc_fetched.strftime('%Y-%m-%dT%H:%M:%SZ')})  — {origin}"
    )
    kind_text = "timeline deadline" if all_kinds else "paper deadline"
    shown_text = str(shown) if matched == shown else f"{shown} of {matched}"
    plural = "" if shown == 1 else "s"
    raw.append(
        f"showing  : {shown_text} {kind_text}{plural} · {tracked} {category_label(category)} "
        f"series tracked · display tz {tz_label} ({offset})"
    )
    if args.days:
        raw.append(
            f"window   : deadlines within the next {args.days} day(s) of "
            f"{utc_fetched.strftime('%Y-%m-%dT%H:%M:%SZ')}"
        )
    if matched != shown:
        raw.append(
            f"limit    : {matched - shown} more matching row(s) hidden by --limit {args.limit}"
        )
    if tbd_count and not args.include_tbd:
        verb = "has" if tbd_count == 1 else "have"
        pronoun = "it" if tbd_count == 1 else "them"
        raw.append(
            f"tbd      : {tbd_count} series {verb} no announced deadline; "
            f"use --include-tbd to list {pronoun} (TBD is unknown, not a date)"
        )
    raw.append(
        "caveat   : live catalog data can change; always verify the deadline on the "
        "official venue page before acting."
    )
    lines: list[str] = []
    for line in raw:
        if line.startswith(HORIZONTAL):
            lines.append(line)
        else:
            lines.extend(wrap_prefixed(line, term_width, 11))
    return lines


def tbd_lines(entries: list[TbdEntry], *, term_width: int, colors: bool) -> list[str]:
    lines: list[str] = [""]
    lines.append(paint(f"TBD — deadline not yet announced ({len(entries)} series)", BOLD_CYAN, colors))
    if not entries:
        lines.append("  (none in the selected category)")
        return lines
    for entry in entries:
        head = (
            f"  {entry.conference} {entry.year}  ·  CCF {entry.rank_cell}  ·  "
            f"{entry.event_date or DASH}  ·  {entry.place or DASH}"
        )
        lines.extend(wrap_prefixed(head, term_width, 2))
        link = entry.link or "(no link in catalog)"
        lines.extend(
            wrap_prefixed(f"      deadline not announced (TBD) — {link}", term_width, 6)
        )
    return lines


