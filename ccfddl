#!/usr/bin/env python3
"""
ccfddl — live CCF conference deadline viewer.

Fetches the public CCFDDL catalog on every invocation and prints upcoming paper
submission deadlines, converted from each venue's own source timezone to UTC for
ordering and to the selected display timezone for presentation.

No conference data is hardcoded here: the only data literals are the catalog URL,
the source-timezone alias rules required to interpret the catalog, formatting
constants and labels. Live catalog: https://ccfddl.com/conference/allconf.json

Run `./ccfddl --help` for options.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import socket
import sys
import textwrap
import unicodedata
from dataclasses import dataclass, field
from datetime import datetime, timedelta, timezone, tzinfo
from typing import Any, Iterable, Optional
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError

# ---------------------------------------------------------------------------
# Constants: data URL, timezone alias rules, formatting and labels only.
# ---------------------------------------------------------------------------

DATA_URL = "https://ccfddl.com/conference/allconf.json"
USER_AGENT = "ccfddl-cli/2.0 (+https://ccfddl.com; live conference deadline viewer)"
VERSION = "2.1.0"
DEFAULT_CATEGORY = "AI"
DEFAULT_TIMEOUT = 20.0

# Source-timezone interpretation rules (verified against the live catalog):
#   AoE = "Anywhere on Earth" = UTC-12, a FIXED offset -- never +12.
#   PT  = America/Los_Angeles, DST-aware -- never a fixed -8.
#   UTC = +00:00; UTC+N / UTC-N = fixed numeric offsets.
# Any other value that is a real IANA name is accepted; anything else is
# reported and skipped, never silently treated as local time.
TZ_ALIASES = {
    "AoE": ("fixed", -12, 0),
    "PT": ("iana", "America/Los_Angeles"),
}

PAPER = "deadline"
OTHER_KINDS = ("abstract_deadline", "rebuttal_deadline", "decision_deadline")
ALL_KINDS = (PAPER,) + OTHER_KINDS
KIND_LABELS = {
    PAPER: "paper",
    "abstract_deadline": "abstract",
    "rebuttal_deadline": "rebuttal",
    "decision_deadline": "decision",
}

WEEKDAYS = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
DASH = "–"           # en dash: "no value"
ELLIPSIS = "…"
HORIZONTAL = "─"     # box-drawing horizontal rule

UTC_OFFSET_RE = re.compile(r"^(?:UTC|GMT)([+-])(\d{1,2})(?::?(\d{2}))?$")
DEADLINE_RE = re.compile(r"^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$")

DAY = 86400
RED = "31"
YELLOW = "33"
GREEN = "32"
BOLD = "1"
DIM = "2"
CYAN = "36"
BOLD_CYAN = "1;36"
RANK_COLORS = {"A": "1;31", "B": YELLOW, "C": CYAN, "N": DIM}


class CliError(Exception):
    """Fatal, user-facing error; no table is printed."""

    def __init__(self, message: str, code: int = 1) -> None:
        super().__init__(message)
        self.message = message
        self.code = code


class UsageError(CliError):
    """Invalid user value that can only be validated once the catalog is loaded."""

    def __init__(self, message: str) -> None:
        super().__init__(message, code=2)


# ---------------------------------------------------------------------------
# Timezones
# ---------------------------------------------------------------------------


@dataclass(frozen=True)
class SourceZone:
    """A timezone as declared by an edition in the catalog."""

    label: str
    tz: tzinfo


def parse_source_timezone(value: Any) -> Optional[SourceZone]:
    """Map a catalog timezone value to a tzinfo; None when unrecognized."""
    if value is None:
        return None
    label = str(value).strip()
    if not label:
        return None

    alias = TZ_ALIASES.get(label)
    if alias is not None:
        kind, *payload = alias
        if kind == "fixed":
            return SourceZone(label, timezone(timedelta(hours=payload[0], minutes=payload[1])))
        try:
            return SourceZone(label, ZoneInfo(payload[0]))
        except (ZoneInfoNotFoundError, ValueError):
            return None

    upper = label.upper()
    if upper in ("UTC", "UTC+0", "UTC-0", "GMT", "GMT+0", "Z"):
        return SourceZone(label, timezone.utc)

    match = UTC_OFFSET_RE.fullmatch(label)
    if match is not None:
        sign = 1 if match.group(1) == "+" else -1
        hours = int(match.group(2))
        minutes = int(match.group(3) or 0)
        if hours > 14 or minutes > 59:
            return None
        return SourceZone(label, timezone(sign * timedelta(hours=hours, minutes=minutes)))

    # Future-proofing: accept a genuine IANA name if the catalog ever uses one.
    if "/" in label:
        try:
            return SourceZone(label, ZoneInfo(label))
        except (ZoneInfoNotFoundError, ValueError):
            return None

    return None


def detect_system_timezone() -> tuple[str, tzinfo]:
    """Best-effort resolution of the system's IANA timezone."""
    env_tz = os.environ.get("TZ")
    if env_tz:
        try:
            return env_tz, ZoneInfo(env_tz)
        except (ZoneInfoNotFoundError, ValueError):
            pass

    candidates: list[str] = []
    try:
        with open("/etc/timezone", "r", encoding="utf-8") as handle:
            candidates.append(handle.read().strip())
    except OSError:
        pass
    try:
        real = os.path.realpath("/etc/localtime")
        marker = "zoneinfo/"
        if marker in real:
            candidates.append(real.split(marker, 1)[1])
    except OSError:
        pass

    for candidate in candidates:
        if not candidate:
            continue
        try:
            return candidate, ZoneInfo(candidate)
        except (ZoneInfoNotFoundError, ValueError):
            continue

    local = datetime.now().astimezone().tzinfo or timezone.utc
    label = getattr(local, "key", None) or datetime.now().astimezone().tzname() or "local"
    return label, local


def validate_display_tz(value: str) -> str:
    try:
        ZoneInfo(value)
    except (ZoneInfoNotFoundError, ValueError):
        raise argparse.ArgumentTypeError(
            f"unknown timezone {value!r}; use an IANA name "
            f"(for example Asia/Shanghai, America/Los_Angeles) or UTC"
        )
    return value


def format_offset_seconds(moment: datetime) -> str:
    offset = moment.utcoffset() or timedelta(0)
    total = int(offset.total_seconds())
    sign = "+" if total >= 0 else "-"
    total = abs(total)
    return f"UTC{sign}{total // 3600:02d}:{(total % 3600) // 60:02d}"


# ---------------------------------------------------------------------------
