@dataclass
class Warnings:
    unknown_timezones: dict[str, set[str]] = field(default_factory=dict)
    malformed_dates: list[str] = field(default_factory=list)
    malformed_count: int = 0

    def unknown_tz(self, label: Any, conference: str) -> None:
        key = "<missing>" if label is None else str(label)
        self.unknown_timezones.setdefault(key, set()).add(conference)

    def malformed(self, field_name: str, raw: Any, conference: str, year: Any) -> None:
        self.malformed_count += 1
        if len(self.malformed_dates) < 5:
            self.malformed_dates.append(
                f"{conference} {year}: {field_name}={raw!r} is not 'YYYY-MM-DD HH:MM:SS'"
            )

    def lines(self) -> list[str]:
        out: list[str] = []
        for label, conferences in sorted(self.unknown_timezones.items(), key=lambda item: item[0]):
            names = ", ".join(sorted(conferences)[:4])
            suffix = f" (affects: {names})" if names else ""
            out.append(f"unrecognized source timezone {label!r}; skipped its deadlines{suffix}")
        if self.malformed_count:
            out.append(
                f"skipped {self.malformed_count} unparsable date value(s); only "
                "'YYYY-MM-DD HH:MM:SS' and 'TBD' are accepted, nothing is guessed"
            )
            for detail in self.malformed_dates:
                out.append("  " + detail)
        return out


def read_catalog(args: argparse.Namespace, now_utc: datetime) -> tuple[list[dict], datetime, str]:
    """Return (catalog, fetched_at, origin); raise CliError on any failure."""
    if args.data_file:
        if args.data_file == "-":
            try:
                payload = sys.stdin.buffer.read()
            except OSError as exc:
                raise CliError(f"cannot read catalog from stdin: {exc}") from exc
            fetched_at = now_utc
            origin = "stdin"
        else:
            path = args.data_file
            try:
                stat = os.stat(path)
                with open(path, "rb") as handle:
                    payload = handle.read()
            except OSError as exc:
                detail = getattr(exc, "strerror", None) or str(exc)
                raise CliError(f"cannot read data file {path!r}: {detail}") from exc
            fetched_at = datetime.fromtimestamp(stat.st_mtime, timezone.utc).replace(microsecond=0)
            origin = f"local file {path}"
    else:
        request = Request(
            DATA_URL,
            headers={"User-Agent": USER_AGENT, "Accept": "application/json"},
        )
        try:
            with urlopen(request, timeout=args.timeout) as response:
                payload = response.read()
        except HTTPError as exc:
            raise CliError(
                f"HTTP {exc.code} from {DATA_URL}: {exc.reason}; no data displayed "
                "(this tool never falls back to a stale table)"
            ) from exc
        except URLError as exc:
            raise CliError(
                f"cannot fetch {DATA_URL}: {exc.reason}; no data displayed "
                "(this tool never falls back to a stale table)"
            ) from exc
        except (TimeoutError, socket.timeout) as exc:
            raise CliError(
                f"timed out after {args.timeout:g}s fetching {DATA_URL}; no data displayed"
            ) from exc
        except OSError as exc:
            raise CliError(f"cannot fetch {DATA_URL}: {exc}; no data displayed") from exc
        fetched_at = datetime.now(timezone.utc).replace(microsecond=0)
        origin = "live fetch"

    try:
        text = payload.decode("utf-8-sig")
    except UnicodeDecodeError as exc:
        raise CliError(f"catalog from {origin} is not valid UTF-8: {exc}") from exc
    try:
        catalog = json.loads(text)
    except json.JSONDecodeError as exc:
        raise CliError(
            f"catalog from {origin} is not valid JSON: {exc.msg} "
            f"(line {exc.lineno}, column {exc.colno})"
        ) from exc
    if not isinstance(catalog, list):
        raise CliError(f"catalog from {origin} has an unexpected shape: expected a JSON list")
    series = [item for item in catalog if isinstance(item, dict)]
    if not series:
        raise CliError(f"catalog from {origin} contains no conference series")
    return series, fetched_at, origin


def catalog_categories(catalog: Iterable[dict]) -> tuple[dict[str, str], list[str]]:
    """Return (casefolded sub -> canonical sub, sorted canonical list)."""
    by_fold: dict[str, str] = {}
    for series in catalog:
        sub = series.get("sub")
        if isinstance(sub, str) and sub.strip():
            by_fold.setdefault(sub.strip().casefold(), sub.strip())
    return by_fold, sorted(set(by_fold.values()), key=str.casefold)


def resolve_category(catalog: list[dict], raw: Optional[str]) -> Optional[str]:
    """Return the canonical category name, or None meaning every area."""
    by_fold, available = catalog_categories(catalog)
    requested = DEFAULT_CATEGORY if raw is None else raw.strip()
    if requested.casefold() == "all":
        return None
    canonical = by_fold.get(requested.casefold())
    if canonical is None:
        raise UsageError(
            f"unknown category {requested!r}; available: "
            + ", ".join(available)
            + " (or 'all')"
        )
    return canonical


def series_rank(series: dict) -> Optional[str]:
    rank = (series.get("rank") or {}).get("ccf")
    if rank is None:
        return None
    text = str(rank).strip().upper()
    return text or None


def parse_deadline(raw: Any) -> tuple[Optional[datetime], str]:
    """Parse a source datetime. 'TBD' is never interpreted as a date."""
    if raw is None:
        return None, "absent"
    text = str(raw).strip()
    if not text:
        return None, "absent"
    if text.upper() == "TBD":
        return None, "tbd"
    if not DEADLINE_RE.fullmatch(text):
        return None, "malformed"
    try:
        return datetime.strptime(text, "%Y-%m-%d %H:%M:%S"), "ok"
    except ValueError:
        return None, "malformed"


